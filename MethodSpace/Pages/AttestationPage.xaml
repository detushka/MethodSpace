<Page x:Class="MethodSpace.Pages.AttestationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аттестация преподавателей"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Аттестация преподавателей"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}"
                Padding="8"
                Margin="0">
            <ListView x:Name="AttestationList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Преподаватель" Width="200" DisplayMemberBinding="{Binding TeacherName}"/>
                        <GridViewColumn Header="Дата аттестации" Width="120"
                                        DisplayMemberBinding="{Binding AttestationDate, StringFormat='dd.MM.yyyy'}"/>
                        <GridViewColumn Header="Результат" Width="120" DisplayMemberBinding="{Binding Result}"/>
                        <GridViewColumn Header="Номер сертификата" Width="160" DisplayMemberBinding="{Binding CertificateNumber}"/>
                        <GridViewColumn Header="Комментарий" Width="300" DisplayMemberBinding="{Binding Comments}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Page>
