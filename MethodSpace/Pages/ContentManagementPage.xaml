<Page x:Class="MethodSpace.Pages.ContentManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление контентом"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление контентом"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}"
                Padding="12"
                Margin="0">
            <TabControl>
                <TabItem Header="Новости">
                    <ListView x:Name="NewsList" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Заголовок" Width="300" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Дата" Width="150" DisplayMemberBinding="{Binding PublishDate, StringFormat='dd.MM.yyyy'}"/>
                                <GridViewColumn Header="Автор" Width="150" DisplayMemberBinding="{Binding AuthorName}"/>
                                <GridViewColumn Header="Действия" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Изменить" Tag="{Binding NewsID}" Click="EditNews_Click"
                                                        Width="78" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}"/>
                                                <Button Content="Удалить" Tag="{Binding NewsID}" Click="DeleteNews_Click"
                                                        Width="78" Style="{StaticResource DangerButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Документы">
                    <ListView x:Name="DocumentsList" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Название" Width="300" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Тип" Width="150" DisplayMemberBinding="{Binding DocumentType}"/>
                                <GridViewColumn Header="Дата" Width="120" DisplayMemberBinding="{Binding UploadDate, StringFormat='dd.MM.yyyy'}"/>
                                <GridViewColumn Header="Действия" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Удалить" Tag="{Binding DocumentID}" Click="DeleteDocument_Click"
                                                    Width="82" Style="{StaticResource DangerButtonStyle}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Курсы">
                    <ListView x:Name="CoursesList" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Название" Width="300" DisplayMemberBinding="{Binding CourseName}"/>
                                <GridViewColumn Header="Дата начала" Width="120" DisplayMemberBinding="{Binding StartDate, StringFormat='dd.MM.yyyy'}"/>
                                <GridViewColumn Header="Дата окончания" Width="120" DisplayMemberBinding="{Binding EndDate, StringFormat='dd.MM.yyyy'}"/>
                                <GridViewColumn Header="Действия" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Удалить" Tag="{Binding CourseID}" Click="DeleteCourse_Click"
                                                    Width="82" Style="{StaticResource DangerButtonStyle}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
