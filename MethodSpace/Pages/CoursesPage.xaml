<Page x:Class="MethodSpace.Pages.CoursesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Курсы повышения квалификации"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Курсы повышения квалификации"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}">
            <CheckBox x:Name="ShowOnlyActive"
                      Content="Показать только активные курсы"
                      Checked="Filter_Changed"
                      Unchecked="Filter_Changed"/>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource FilterPanelStyle}"
                Padding="8"
                Margin="0">
            <ListView x:Name="CoursesList"
                      SelectionChanged="CoursesList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название курса" Width="300" DisplayMemberBinding="{Binding CourseName}"/>
                        <GridViewColumn Header="Дата начала" Width="120"
                                        DisplayMemberBinding="{Binding StartDate, StringFormat='dd.MM.yyyy'}"/>
                        <GridViewColumn Header="Дата окончания" Width="120"
                                        DisplayMemberBinding="{Binding EndDate, StringFormat='dd.MM.yyyy'}"/>
                        <GridViewColumn Header="Место проведения" Width="200" DisplayMemberBinding="{Binding Location}"/>
                        <GridViewColumn Header="Свободно мест" Width="110" DisplayMemberBinding="{Binding FreePlaces}"/>
                        <GridViewColumn Header="Действия" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Записаться"
                                            Tag="{Binding CourseID}"
                                            Click="RegisterButton_Click"
                                            Style="{StaticResource SuccessButtonStyle}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Page>
