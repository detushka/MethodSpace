<Page x:Class="MethodSpace.Pages.FeedbackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Обратная связь">

    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Обратная связь"
                       Style="{StaticResource PageTitleStyle}"/>

            <Border Grid.Row="1"
                    Style="{StaticResource FilterPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Выберите тип сообщения"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="MessageToAdmin" Content="Сообщение администрации" GroupName="MessageType" IsChecked="True"
                                     Checked="MessageType_Changed"/>
                        <RadioButton x:Name="ConsultationRequest" Content="Запись на консультацию" GroupName="MessageType"
                                     Checked="MessageType_Changed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Тема" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="SubjectBox" Grid.Row="3" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="4" Text="Сообщение" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="MessageBox"
                     Grid.Row="5"
                     Height="160"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,16"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ConsultationDatePanel"
                        Content="Выбрать дату консультации"
                        Visibility="Collapsed"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SelectDate_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Отправить"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="SendButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
