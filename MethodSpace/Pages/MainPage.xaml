<Page x:Class="MethodSpace.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная"
      Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock x:Name="WelcomeText" Style="{StaticResource PageTitleStyle}"/>

            <Border Style="{StaticResource FilterPanelStyle}">
                <StackPanel>
                    <TextBlock Text="О колледже"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Наш колледж — это современное образовательное учреждение, предоставляющее качественное профессиональное образование. Методическая служба колледжа обеспечивает поддержку педагогических работников, организует повышение квалификации и внедряет инновационные методики обучения."
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FilterPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Новости методической службы"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <ListBox x:Name="NewsList"
                             MouseDoubleClick="NewsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCardBorderStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="10,1,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:dd.MM.yyyy}">
                                                        <Binding Path="PublishDate"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
