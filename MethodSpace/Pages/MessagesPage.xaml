<Page x:Class="MethodSpace.Pages.MessagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сообщения"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сообщения"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}"
                Padding="8"
                Margin="0">
            <ListView x:Name="MessagesList"
                      SelectionChanged="Message_Selected">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="От кого" Width="200" DisplayMemberBinding="{Binding SenderName}"/>
                        <GridViewColumn Header="Тема" Width="300" DisplayMemberBinding="{Binding Subject}"/>
                        <GridViewColumn Header="Дата" Width="150" DisplayMemberBinding="{Binding SentDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                        <GridViewColumn Header="Статус" Width="180" DisplayMemberBinding="{Binding StatusDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border x:Name="MessageDetailPanel"
                Grid.Row="2"
                Style="{StaticResource FilterPanelStyle}"
                Margin="0,16,0,0"
                Visibility="Collapsed">
            <ContentControl x:Name="DetailContent"/>
        </Border>
    </Grid>
</Page>
