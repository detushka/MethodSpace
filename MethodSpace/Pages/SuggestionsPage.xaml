<Page x:Class="MethodSpace.Pages.SuggestionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Предложения"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сбор предложений"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}">
            <TextBlock Text="Поделитесь идеями по учебному процессу, методической поддержке и внутренним сервисам колледжа."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </Border>

        <TextBlock Grid.Row="2" Text="Категория" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="CategoryBox" Grid.Row="3" Margin="0,0,0,16">
            <ComboBoxItem Content="Учебный процесс" IsSelected="True"/>
            <ComboBoxItem Content="Методическая работа"/>
            <ComboBoxItem Content="Материально-техническая база"/>
            <ComboBoxItem Content="Социальные вопросы"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Ваше предложение" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="SuggestionBox"
                 Grid.Row="5"
                 Height="180"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,16"/>

        <StackPanel Grid.Row="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отправить предложение"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="SendSuggestion_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource SuccessBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
