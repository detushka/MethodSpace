<Page x:Class="MethodSpace.Pages.TeacherTipsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Советы педагогам">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Советы педагогам"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}">
            <WrapPanel>
                <RadioButton x:Name="AllTips" Content="Все советы" GroupName="TipType" IsChecked="True"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="LessonTips" Content="Советы для урока" GroupName="TipType"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="PracticalRecs" Content="Практические рекомендации" GroupName="TipType"
                             Checked="Filter_Changed"/>
            </WrapPanel>
        </Border>

        <ListBox x:Name="TipsList"
                 Grid.Row="2"
                 MouseDoubleClick="TipsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ItemCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,10"/>
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Опубликовано: {0:dd.MM.yyyy}">
                                        <Binding Path="PublishDate"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
