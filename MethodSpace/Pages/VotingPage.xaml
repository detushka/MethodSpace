<Page x:Class="MethodSpace.Pages.VotingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Голосования"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Активные голосования"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource FilterPanelStyle}"
                Padding="8"
                Margin="0">
            <ListView x:Name="VotingList"
                      SelectionChanged="VotingList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Вопрос" Width="300" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Описание" Width="400" DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="Дата окончания" Width="150"
                                        DisplayMemberBinding="{Binding EndDate, StringFormat='dd.MM.yyyy'}"/>
                        <GridViewColumn Header="Действия" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Проголосовать"
                                            Tag="{Binding SurveyID}"
                                            Click="VoteButton_Click"
                                            Style="{StaticResource SuccessButtonStyle}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Page>
