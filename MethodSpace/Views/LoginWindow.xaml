<Window x:Class="MethodSpace.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MethodSpace - Вход в систему"
        Width="980"
        Height="620"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="18">
        <Border Background="{StaticResource CardBrush}"
                CornerRadius="30"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="30,0,0,30"
                        Background="{StaticResource SidebarBrush}">
                    <Grid Margin="34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MethodSpace"
                                       FontSize="38"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Цифровое рабочее пространство методической службы колледжа"
                                       Margin="0,14,0,0"
                                       Foreground="#D3E0EC"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>

                            
                        </StackPanel>

                        
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Вход в систему"
                                       Style="{StaticResource PageTitleStyle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Используйте рабочую учетную запись или быстрый вход в локальном режиме."
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="_"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="MinimizeWindow_Click"/>
                            <Button Content="X"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="CloseWindow_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Email"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailBox"
                             Grid.Row="2"
                             Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="3"
                               Text="Пароль"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Row="4"
                                 Margin="0,0,0,18"/>

                    <StackPanel x:Name="DemoAccountsPanel"
                                Grid.Row="5"
                                Visibility="Collapsed"
                                Margin="0,0,0,18">
                        <TextBlock Text="Быстрый вход в локальном режиме"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Администратор"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="UseAdmin_Click"
                                    Margin="0,0,10,10"/>
                            <Button Content="Методист"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="UseMethodist_Click"
                                    Margin="0,0,10,10"/>
                            <Button Content="Преподаватель"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="UseTeacher_Click"
                                    Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <Button x:Name="LoginButton"
                                Content="Войти"
                                Height="46"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="LoginButton_Click"/>

                        <TextBlock x:Name="ErrorText"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
